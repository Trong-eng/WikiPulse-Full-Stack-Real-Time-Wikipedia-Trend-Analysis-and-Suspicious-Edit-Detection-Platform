  "info": {
    "title": "WikiPulse API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/activity": {
      "get": {
        "description": "One-minute activity windows of a wiki, newest first; one window when `window` is set.",
        "operationId": "activity_api_v1_activity_get",
        "parameters": [
          {
            "description": "Wiki in WIKI_ALLOWLIST, e.g. enwiki.",
            "in": "query",
            "name": "wiki",
            "required": false,
            "schema": {
              "default": "enwiki",
              "description": "Wiki in WIKI_ALLOWLIST, e.g. enwiki.",
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]*$",
              "title": "Wiki",
              "type": "string"
            }
          },
          {
            "description": "Timezone-aware ISO window start; omitted means the latest window.",
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Timezone-aware ISO window start; omitted means the latest window.",
              "title": "Window"
            }
          },
          {
            "description": "Maximum rows returned.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Maximum rows returned.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Activity"
      }
    },
    "/api/v1/events/{event_id}": {
      "get": {
        "description": "Detail of one Silver event, kept 7 days; 404 EVENT_NOT_FOUND when absent or expired.",
        "operationId": "event_api_v1_events__event_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "event_id",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Event Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Event"
      }
    },
    "/api/v1/suspicious-edits": {
      "get": {
        "description": "Edits of the last `minutes` one-minute buckets ending at `window` or the latest one.",
        "operationId": "suspicious_edits_api_v1_suspicious_edits_get",
        "parameters": [
          {
            "description": "Wiki in WIKI_ALLOWLIST, e.g. enwiki.",
            "in": "query",
            "name": "wiki",
            "required": false,
            "schema": {
              "default": "enwiki",
              "description": "Wiki in WIKI_ALLOWLIST, e.g. enwiki.",
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]*$",
              "title": "Wiki",
              "type": "string"
            }
          },
          {
            "description": "Timezone-aware ISO window start; omitted means the latest window.",
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Timezone-aware ISO window start; omitted means the latest window.",
              "title": "Window"
            }
          },
          {
            "description": "One-minute buckets to read.",
            "in": "query",
            "name": "minutes",
            "required": false,
            "schema": {
              "default": 5,
              "description": "One-minute buckets to read.",
              "maximum": 15,
              "minimum": 1,
              "title": "Minutes",
              "type": "integer"
            }
          },
          {
            "description": "Lowest risk_score returned.",
            "in": "query",
            "name": "min_score",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Lowest risk_score returned.",
              "maximum": 100,
              "minimum": 0,
              "title": "Min Score",
              "type": "integer"
            }
          },
          {
            "description": "Maximum rows returned.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Maximum rows returned.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuspiciousEditEnvelope"
                }
              }
            },
            "description": "Successful Response"
