#!/bin/bash
set -euo pipefail
mkdir -p /var/lib/wikipulse
exec >> /var/log/wikipulse-bootstrap.log 2>&1
echo RUNNING > /var/lib/wikipulse/status
trap 'echo FAILED > /var/lib/wikipulse/status' ERR
systemd-run --unit=wikipulse-expire --on-active=3h /usr/bin/systemctl poweroff
echo '${source_revision}' > /var/lib/wikipulse/source_revision
printf '%s' '${bootstrap_b64}' | base64 -d > /usr/local/bin/wikipulse-bootstrap
printf '%s' '${verify_b64}' | base64 -d > /usr/local/bin/wikipulse-verify
chmod 0755 /usr/local/bin/wikipulse-bootstrap /usr/local/bin/wikipulse-verify
/usr/local/bin/wikipulse-bootstrap '${source_revision}'
echo READY > /var/lib/wikipulse/status
